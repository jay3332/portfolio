---
import NavBar from '../components/NavBar.astro';
import Footer from '../components/Footer.astro';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

export interface Props {
  title: string;
  navbar?: 'hide' | 'transparent' | 'show';
  showFooter?: boolean;
}

const { title, navbar = 'show', showFooter = true } = Astro.props;
const META_MESSAGE = "A student developer, interested in full-stack software and embedded development. This portfolio showcases my projects and accomplishments.";
const EXTERNAL_ICON = "https://github.com/jay3332/jay3332/blob/main/jay3332_circle.png?raw=true";
const SITE_URL = "https://jay3332.pages.dev"
---

<!DOCTYPE html>
<html lang="en" class="bg-black text-white">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <meta name="title" content="Jaysen Tsao (jay3332)">
    <meta name="description" content={META_MESSAGE}>
    <meta name="theme-color" content="#0a0e16">

    <!-- Open Graph / Facebook / Discord -->
    <meta property="og:type" content="website">
    <meta property="og:url" content={SITE_URL}>
    <meta property="og:title" content="Jaysen Tsao (jay3332)">
    <meta property="og:description" content={META_MESSAGE}>
    <meta property="og:image" content={EXTERNAL_ICON}>
    <meta property="og:image:alt" content="jay3332 logo">
    <meta property="og:site_name" content="Jaysen Tsao">

    <!-- Twitter -->
    <meta property="twitter:url" content={SITE_URL}>
    <meta property="twitter:title" content="Jaysen Tsao (jay3332)">
    <meta property="twitter:description" content={META_MESSAGE}>
    <meta property="twitter:image" content={EXTERNAL_ICON}>
    <meta property="twitter:image:alt" content="jay3332 logo">

    <!-- KaTeX -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css"
      integrity="sha384-n8MVd4RsNIU0tAv4ct0nTaAbDJwPJzDEaqSD1odI+WdtXRGWt2kTvGFasHpSy3SV"
      crossorigin="anonymous"
    />

    <ClientRouter />

    <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
    <title>{title}</title>
  </head>
  <body class="m-0 font-sans flex flex-col min-h-[100vh]">
    {navbar === 'hide'
      ? undefined
      : navbar === 'transparent'
      ? <NavBar transparent={true} />
      : <NavBar />
    }
    <slot />
    {showFooter && <Footer />}
  </body>
</html>