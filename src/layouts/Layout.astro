---
import NavBar from '../components/NavBar.astro';
import Footer from '../components/Footer.astro';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

export interface Props {
  title: string;
  description?: string;
  image?: string;
  /** og:type, use 'article' for blog posts. */
  type?: 'website' | 'article';
  /** set for pages that shouldn't be indexed (e.g. 404). */
  noindex?: boolean;
  /** ISO date, used for og:article:published_time. */
  publishedTime?: string;
  navbar?: 'hide' | 'transparent' | 'show';
  showFooter?: boolean;
}

const {
  title,
  description = "Hey! I'm an ambitious student, interested in software engineering, compilers, math, startups, and more. This website is my personal portfolio and blog.",
  image = "/jay3332_circle.png",
  type = "website",
  noindex = false,
  publishedTime,
  navbar = 'show',
  showFooter = true,
} = Astro.props;

const SITE_NAME = "Jaysen Tsao";
const origin = Astro.site ?? new URL("https://jay3332.tech");
const canonicalURL = new URL(Astro.url.pathname, origin);
const imageURL = new URL(image, origin);
const fullTitle = title.includes(SITE_NAME) ? title : `${title} — ${SITE_NAME}`;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${origin.origin}/#website`,
      url: origin.origin,
      name: SITE_NAME,
      description,
      publisher: { "@id": `${origin.origin}/#person` },
    },
    {
      "@type": "Person",
      "@id": `${origin.origin}/#person`,
      name: "Jaysen Tsao",
      alternateName: "jay3332",
      url: origin.origin,
      image: new URL("/jay3332_circle.png", origin).href,
      jobTitle: "Software Engineer",
      affiliation: { "@type": "CollegeOrUniversity", name: "Carnegie Mellon University" },
      sameAs: [
        "https://github.com/jay3332",
        "https://www.linkedin.com/in/jay3332",
      ],
    },
    ...(type === "article"
      ? [{
          "@type": "BlogPosting",
          "@id": `${canonicalURL.href}#article`,
          headline: title,
          description,
          image: imageURL.href,
          url: canonicalURL.href,
          ...(publishedTime ? { datePublished: publishedTime } : {}),
          author: { "@id": `${origin.origin}/#person` },
          publisher: { "@id": `${origin.origin}/#person` },
          mainEntityOfPage: canonicalURL.href,
        }]
      : []),
  ],
};
---

<!DOCTYPE html>
<html lang="en" class="bg-page text-content">
  <head>
    <!-- Set the theme before first paint to avoid a flash of the wrong theme,
         and re-apply after each view-transition swap (Astro resets <html>'s
         class to the new page's static class during navigation). -->
    <script is:inline>
      (() => {
        const apply = () => {
          let theme;
          try { theme = localStorage.getItem("theme"); } catch {}
          if (theme !== "light" && theme !== "dark") {
            theme = matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
          }
          const root = document.documentElement;
          root.classList.remove("light", "dark");
          root.classList.add(theme);
        };
        apply();
        if (!window.__themeSwapBound) {
          window.__themeSwapBound = true;
          document.addEventListener("astro:after-swap", apply);
        }
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <!-- Primary Meta Tags -->
    <title>{fullTitle}</title>
    <meta name="description" content={description}>
    <meta name="author" content="Jaysen Tsao">
    <meta name="theme-color" content="#0a0e16">
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"}>
    <link rel="canonical" href={canonicalURL}>

    <!-- Open Graph / Facebook / Discord -->
    <meta property="og:type" content={type}>
    <meta property="og:url" content={canonicalURL}>
    <meta property="og:title" content={fullTitle}>
    <meta property="og:description" content={description}>
    <meta property="og:image" content={imageURL}>
    <meta property="og:image:alt" content="Jaysen Tsao">
    <meta property="og:site_name" content="Jaysen Tsao">
    <meta property="og:locale" content="en_US">
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:url" content={canonicalURL}>
    <meta name="twitter:title" content={fullTitle}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={imageURL}>
    <meta name="twitter:image:alt" content="Jaysen Tsao">

    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

    <!-- KaTeX -->
    <!-- <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css"
      integrity="sha384-n8MVd4RsNIU0tAv4ct0nTaAbDJwPJzDEaqSD1odI+WdtXRGWt2kTvGFasHpSy3SV"
      crossorigin="anonymous"
    /> -->

    <ClientRouter />

    <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
  </head>
  <body class="m-0 font-sans flex flex-col min-h-[100vh]">
    {navbar === 'hide'
      ? undefined
      : navbar === 'transparent'
      ? <NavBar transparent={true} />
      : <NavBar />
    }
    <slot />
    {showFooter && <Footer />}
  </body>
</html>