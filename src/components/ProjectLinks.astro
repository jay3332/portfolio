---
import { z } from 'astro/zod'
import { projectsSchema } from '../content.config'
import { Icon } from "astro-icon/components"

export interface Props {
  data: z.infer<typeof projectsSchema>,
}
const { data } = Astro.props
const DIAG_ARROW_CLASS = 
  "text-white -rotate-45 text-opacity-30 group-hover/btn:text-opacity-100 translate-x-0 translate-y-0 "
  + "group-hover/btn:translate-x-0.5 group-hover/btn:-translate-y-0.5 transition-all"
---

<div class="flex flex-wrap mt-2 gap-x-4">
  {(data.repo ?? data.org) && (
    <object>
      <a
        class="flex items-center text-sm font-semibold gap-x-1 text-white/80 hover:text-white/100 group/btn"
        href={`https://github.com/${data.repo ?? data.org}`}
        target="_blank"
      >
        <Icon name="github" class="transition-all mr-0.5 text-base" />
        <span class="transition">GitHub</span>
        <Icon name="arrow-right" class={DIAG_ARROW_CLASS} />
      </a>
    </object>
  )}
  {data.url && (
    <object>
      <a
        class="flex items-center text-sm font-semibold gap-x-1 text-white/80 hover:text-white/100 group/btn"
        href={data.url}
        target="_blank"
      >
        <Icon name="link" class="transition-all mr-0.5 text-base" />
        <span class="transition" set:html={data.label ?? "Visit Link"} />
        <Icon name="arrow-right" class={DIAG_ARROW_CLASS} />
      </a>
    </object>
  )}
</div>
