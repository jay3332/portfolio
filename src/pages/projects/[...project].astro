---
import Layout from '../../layouts/Layout.astro';
import { getCollection, getEntry } from 'astro:content';
import ProjectCard from "../../components/ProjectCard.astro";
import ProjectLinks from "../../components/ProjectLinks.astro";
import { Icon } from 'astro-icon/components';

const allProjects = await getCollection('projects')
const { project: slug } = Astro.params

const entry = slug ? await getEntry('projects', slug) : null
if (!entry)
  return Astro.redirect('/404')

const Content = await entry?.render().then(c => c.Content)
---

<Layout title="jay3332: Projects">
  <div class="flex flex-grow h-[calc(100lvh-4rem-8rem)]">
    <div class="tablet:hidden overflow-x-hidden overflow-y-auto p-2 h-full flex-grow flex flex-col items-end">
      <div class="flex flex-col gap-y-3">
        {allProjects.map(project => (
          <ProjectCard project={project} slug={slug} entry={entry} />
        ))}
      </div>
    </div>
    <div class="overflow-y-auto h-full py-4 w-[65ch] tablet:w-auto flex-grow tablet:flex tablet:justify-center">
      {Content && <div class="px-4 max-w-[65ch] tablet:max-w-full">
        <h1 class="pt-4 mb-4 text-white/80 text-4xl font-bold" id={entry.slug}>{entry.data.name}</h1>
        <ProjectLinks data={entry.data} />
        <div class="prose mt-10 [&>*>img]:!rounded-2xl">
          <Content />
        </div>
        <div class="flex pt-8 tablet:pb-8 pb-4 w-full justify-center">
          <a class="btn btn-ghost group" href="/projects/all">
            <Icon name="arrow-right" class="rotate-180 group-hover:-translate-x-1 transition-transform" />
            View More Projects
          </a>
          <div class="divider divider-horizontal" />
          <a class="btn btn-ghost group" href=`#${entry.slug}`>
            <Icon name="arrow-right" class="-rotate-90 group-hover:-translate-y-1 transition-transform" />
            Back to Top
          </a>
        </div>
      </div>}
    </div>
  </div>
</Layout>

<script define:vars={{ slug }}>
  document.addEventListener('astro:page-load', () => {
    const currentCard = document.getElementById(`project__${slug}`)
    if (currentCard) {
      currentCard.scrollIntoView({ behavior: 'instant', block: 'center' })
    }
  })
</script>