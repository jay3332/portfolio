---
import Layout from '../../layouts/Layout.astro';
import { getCollection, getEntry, render } from 'astro:content';
import ProjectCard from "../../components/ProjectCard.astro";
import ProjectLinks from "../../components/ProjectLinks.astro";
import { Icon } from 'astro-icon/components';
import ProjectSkills from "../../components/ProjectSkills.astro";

export const prerender = true;

export async function getStaticPaths() {
  const entries = await getCollection('projects')
    .then(p => p.sort((a, b) => (a.data.order ?? Infinity) - (b.data.order ?? Infinity)));
    
  return entries.map(entry => ({
    params: { project: entry.id }, 
    props: { entry, allProjects: entries },
  }));
}

const { entry, allProjects } = Astro.props;
if (!entry)
  return Astro.redirect('/404');
const { Content } = await render(entry);
---

<Layout title="Jaysen Tsao: Projects">
  <div class="flex flex-grow h-[calc(100lvh-4rem-8rem)]">
    <div class="tablet:hidden overflow-x-hidden overflow-y-auto p-2 h-full flex-grow flex flex-col items-end">
      <div class="flex flex-col gap-y-3">
        {allProjects.map(project => (
          <ProjectCard project={project} slug={entry.id} />
        ))}
      </div>
    </div>
    <div class="overflow-y-auto h-full py-4 w-[65ch] tablet:w-auto flex-grow tablet:flex tablet:justify-center">
      {Content && <div class="px-4 max-w-[65ch] tablet:max-w-full">
        <h1 class="pt-4 mb-2 text-white/80 text-4xl font-bold" id={entry.id}>{entry.data.name}</h1>
        <div class="flex flex-wrap gap-2 pb-2">
          <ProjectSkills skills={entry.data.skills} />
        </div>
        <ProjectLinks data={entry.data} />
        <div class="prose mt-10 [&>*>img]:!rounded-2xl">
          <Content />
        </div>
        <div class="flex pt-8 tablet:pb-8 pb-4 w-full justify-center">
          <a class="btn btn-ghost group" href="/projects/all">
            <Icon name="arrow-right" class="rotate-180 group-hover:-translate-x-1 transition-transform" />
            View More Projects
          </a>
          <div class="divider divider-horizontal" />
          <a class="btn btn-ghost group" href={`#${entry.id}`}>
            <Icon name="arrow-right" class="-rotate-90 group-hover:-translate-y-1 transition-transform" />
            Back to Top
          </a>
        </div>
      </div>}
    </div>
  </div>
</Layout>

<script define:vars={{ id: entry.id }}>
  document.addEventListener('astro:page-load', () => {
    const currentCard = document.getElementById(`project__${id}`)
    if (currentCard) {
      currentCard.scrollIntoView({ behavior: 'instant', block: 'center' })
    }
  })
</script>