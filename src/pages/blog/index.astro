---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const blogs = [
  ...await getCollection("blog"),
  ...await getCollection("blogMdx"),
].sort((a, b) => (b.data.date ?? new Date()).getTime() - (a.data.date ?? new Date()).getTime());
---

<Layout title="Jaysen Tsao: Blog" description="A few of my thoughts">
  {blogs.map(blog => (
    <a href={`/blog/${blog.id}`} class="block p-4 rounded-lg hover:bg-content/5 transition-colors">
      <h2 class="text-2xl font-semibold">{blog.data.title}</h2>
      <p class="text-sm text-content/50 mt-1">{blog.data.brief}</p>
    </a>
  ))}
</Layout>